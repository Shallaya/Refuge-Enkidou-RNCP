{% extends 'base.html.twig' %}

{% block title %}Finaliser ma commande{% endblock %}

{% block body %}
<div class="container my-5">
    <h1>Finaliser ma commande</h1>

    <div class="row">
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Informations de livraison</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form, { attr: { 'data-turbo': 'false' } }) }}
                        {{ form_row(form.name) }}
                        {{ form_row(form.address) }}
                        <div class="row">
                            <div class="col-md-4">
                                {{ form_row(form.postal_code) }}
                            </div>
                            <div class="col-md-8">
                                {{ form_row(form.city) }}
                            </div>
                        </div>
                        {{ form_row(form.country) }}
                        {{ form_row(form.phone) }}
                        
                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                            <i class="fas fa-lock me-2"></i>
                            Procéder au paiement sécurisé
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-header">
                    <h5>Récapitulatif de la commande</h5>
                </div>
                <div class="card-body">
                    {% for item in cart %}
                        <div class="d-flex justify-content-between mb-2">
                            <span>{{ item.productName }} x{{ item.quantity }}</span>
                            <span>{{ ((item.price / 100) * item.quantity)|number_format(2, ',', ' ') }} €</span>
                        </div>
                    {% endfor %}
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between">
                        <strong>Total</strong>
                        <strong class="text-primary">{{ (total / 100)|number_format(2, ',', ' ') }} €</strong>
                    </div>

                    <div class="alert alert-info mt-3">
                        <small>
                            <i class="fas fa-shield-alt me-2"></i>
                            Paiement sécurisé par Stripe
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}