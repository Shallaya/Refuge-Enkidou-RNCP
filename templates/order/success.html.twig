{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
<div class="page-order-cancelled page-order-success">
    <div class="container">
        <div class="cancelled-wrapper">
            {# Card principale #}
            <div class="cancelled-card">
                <div class="cancelled-card__body">
                    <div class="cancelled-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    
                    <h1 class="cancelled-title">Merci pour votre commande !</h1>
                    <p class="cancelled-lead">Votre commande a été confirmée avec succès.</p>
                    
                    <div class="alert alert-info">
                        <strong>Numéro de commande :</strong> {{ order.reference }}
                    </div>

                    <p class="cancelled-section__text" style="margin-bottom: var(--space-lg);">
                        Un email de confirmation a été envoyé à {{ order.user.email }}
                    </p>

                    <div class="action-buttons">
                        <a href="{{ path('app_order_show', {reference: order.reference}) }}" class="btn-retry">
                            <i class="fas fa-eye"></i>
                            Voir ma commande
                        </a>
                        <a href="{{ path('app_order_list') }}" class="btn-orders">
                            <i class="fas fa-list"></i>
                            Mes commandes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}