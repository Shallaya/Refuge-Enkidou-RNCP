{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div class="page-orders">
    <div class="container">
        <h1>Mes commandes</h1>
        
        {% if orders is empty %}
            {# Version améliorée de l'état vide #}
            <div class="empty-state">
                <div class="empty-state__icon">📦</div>
                <h2 class="empty-state__title">Aucune commande pour le moment</h2>
                <p class="empty-state__text">
                    Vous n'avez pas encore passé de commande.<br>
                    Découvrez nos produits et commencez vos achats !
                </p>
                <a href="{{ path('home') }}" class="btn btn--primary">
                    Découvrir nos produits
                </a>
            </div>
        {% else %}
            <div class="orders-table-wrapper">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Date</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                            <tr>
                                <td data-label="Référence" class="order-reference">{{ order.reference }}</td>
                                <td data-label="Date" class="order-date">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td data-label="Montant" class="order-amount">{{ (order.totalAmount)|number_format(2, ',', ' ') }} €</td>
                                <td data-label="Statut">
                                    {% if order.status == 'paid' %}
                                        <span class="status-badge status-badge--paid">Payée</span>
                                    {% elseif order.status == 'pending' %}
                                        <span class="status-badge status-badge--pending">En attente</span>
                                    {% elseif order.status == 'shipped' %}
                                        <span class="status-badge status-badge--shipped">Expédiée</span>
                                    {% elseif order.status == 'delivered' %}
                                        <span class="status-badge status-badge--delivered">Livrée</span>
                                    {% else %}
                                        <span class="status-badge status-badge--cancelled">Annulée</span>
                                    {% endif %}
                                </td>
                                <td data-label="Actions">
                                    <a href="{{ path('app_order_show', {reference: order.reference}) }}" class="btn-details">
                                        <i class="fas fa-eye"></i> Détails
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
