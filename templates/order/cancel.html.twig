{% extends 'base.html.twig' %}

{% block title %}Commande annulée{% endblock %}

{% block body %}
<div class="page-order-cancelled">
    <div class="container">
        <div class="cancelled-wrapper">
            {# Card principale #}
            <div class="cancelled-card">
                <div class="cancelled-card__body">
                    <div class="cancelled-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    
                    <h1 class="cancelled-title">Paiement annulé</h1>
                    <p class="cancelled-lead">Votre commande n'a pas été finalisée.</p>
                    
                    <div class="alert alert-warning">
                        <strong>Numéro de commande :</strong> {{ order.reference }}<br>
                        <small>Cette commande est en attente de paiement</small>
                    </div>

                    <div class="cancelled-section">
                        <h5 class="cancelled-section__title">Que s'est-il passé ?</h5>
                        <p class="cancelled-section__text">
                            Vous avez annulé le paiement ou la session a expiré.<br>
                            Votre commande a été enregistrée mais n'est pas encore payée.
                        </p>
                    </div>

                    <div class="cancelled-section">
                        <h5 class="cancelled-section__title">Récapitulatif de votre commande</h5>
                        <div class="order-summary">
                            {% for item in order.orderItems %}
                                <div class="order-summary__item">
                                    <span>{{ item.productName }} x{{ item.quantity }}</span>
                                    <span>{{ (item.total)|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% endfor %}
                            <hr class="order-summary__divider">
                            <div class="order-summary__total">
                                <strong>Total</strong>
                                <strong class="order-summary__total-amount">{{ (order.totalAmount)|number_format(2, ',', ' ') }} €</strong>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <small>
                            Votre panier a été conservé. Vous pouvez finaliser votre commande à tout moment.
                        </small>
                    </div>

                    <div class="action-buttons">
                        <a href="{{ path('app_order_checkout') }}" class="btn-retry">
                            <i class="fas fa-credit-card"></i>
                            Réessayer le paiement
                        </a>
                        <a href="{{ path('app_order_list') }}" class="btn-orders">
                            <i class="fas fa-list"></i>
                            Mes commandes
                        </a>
                    </div>

                    <div class="secondary-link">
                        <a href="{{ path('app_cart_index') }}" class="secondary-link">
                            <i class="fas fa-shopping-cart"></i>
                            Retour au panier
                        </a>
                    </div>
                </div>
            </div>

            {# Card d'aide #}
            <div class="help-card">
                <div class="help-card__body">
                    <h5 class="help-card__title">
                        <i class="fas fa-question-circle"></i>
                        Besoin d'aide ?
                    </h5>
                    <p class="help-card__text">
                        Si vous rencontrez des difficultés avec le paiement, voici quelques solutions :
                    </p>
                    <ul class="help-card__list">
                        <li>Vérifiez que votre carte bancaire est valide et dispose de fonds suffisants</li>
                        <li>Assurez-vous que votre navigateur autorise les fenêtres pop-up</li>
                        <li>Essayez avec un autre moyen de paiement</li>
                        <li>Contactez notre service client si le problème persiste</li>
                    </ul>
                    
                    <a href="mailto:support@refuge-enkidou.com" class="btn-support">
                        <i class="fas fa-envelope"></i>
                        Contacter le support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}