<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Bienvenue au Le Refuge d'Enkidou{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preload" as="image" href="{{ asset('images/logo.png') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}" data-turbo-track="reload">
			<link rel="stylesheet" href="{{ asset('styles/navbar.css') }}" data-turbo-track="reload">
			<link rel="stylesheet" href="{{ asset('styles/home.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/form.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/cart.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/order.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/product.css') }}" data-turbo-track="reload">
            <link rel="stylesheet" href="{{ asset('styles/checkout.css') }}" data-turbo-track="reload">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
                {{ importmap('navbar') }}
            {% endblock %}
        {% endblock %}
    </head>
    <body>
        {% include "components/_navbar.html.twig" %}

        <main>
        {# affichage des messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-message flash-{{ label }}" style="padding: 15px; margin: 10px 0; border-radius: 4px; 
                    background-color: {{ label == 'success' ? '#d4edda' : (label == 'error' ? '#f8d7da' : '#d1ecf1') }};
                    color: {{ label == 'success' ? '#155724' : (label == 'error' ? '#721c24' : '#0c5460') }};
                    border: 1px solid {{ label == 'success' ? '#c3e6cb' : (label == 'error' ? '#f5c6cb' : '#bee5eb') }};">
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
        </main>

        {% include "components/_reassurance.html.twig" %}
        {% include "components/_footer.html.twig" %}
    </body>
</html>
