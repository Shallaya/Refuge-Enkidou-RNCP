{# 
  Composant : Carte produit
  Usage : {% include 'pet_type/_product_card.html.twig' with {product: product} %}
#}

<article class="product-card">
    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="product-card__link">
        {# Image du produit #}
        <div class="product-card__img-wrapper">
            {% if product.image %}
                <img src="{{ asset('images/products/' ~ product.image) }}" 
                     alt="{{ product.name }}" 
                     class="product-card__img"
                     loading="lazy"
                     width="400"
                     height="400">
            {% else %}
                <div class="product-card__img product-card__img--placeholder">
                    <span class="product-card__placeholder-icon">🌿</span>
                </div>
            {% endif %}
        </div>
        
        {# Informations du produit #}
        <div class="product-card__body">
            {# Badge catégorie (affiché uniquement si "tous les produits") #}
            {% if product.category and product.category.name %}
                <span class="product-card__category">{{ product.category.name }}</span>
            {% endif %}
            
            <h3 class="product-card__name">{{ product.name }}</h3>
            <h3 class="product-card__name">{{ product.shortDescription }}</h3>
            
            <div class="product-card__footer">
                <span class="product-card__price">
                    {% if product.productVariants.first %}
                        {{ product.productVariants.first.price|number_format(2, ',', ' ') }} €
                    {% else %}
                        <span class="product-card__price--unavailable">Prix non disponible</span>
                    {% endif %}
                </span>
                <span class="product-card__cta">
                    Voir le produit →
                </span>
            </div>
        </div>
    </a>
</article>
