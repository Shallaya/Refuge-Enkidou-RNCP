<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; color: #3b2f2f; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { display: flex; background: #6B8E4E; color: white; padding: 10px; align-items: center; justify-content: space-around; gap: 10px; }
        .content { padding: 20px; background: #E8DCCB; }
        .footer { font-size: 12px; color: #999; padding: 10px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header" style="">        
            <h1>Le Refuge d'Enkidou</h1>
            <img src="{{ asset('images/logo1.png') }}" alt="Le Refuge d'Enkidou" style="height: 50px;">
        </div>
        <div class="content">
            {% block content %}{% endblock %}
        </div>
        <div class="footer">
            Ceci est un email automatique, merci de ne pas répondre.
        </div>
    </div>
</body>
</html>