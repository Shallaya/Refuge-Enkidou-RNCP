{% extends 'mails/base.html.twig' %}

{% block content %}

<h1>Salut! Veuillez confirmer votre email !</h1>

<p>
    Veuillez confirmer votre adresse e-mail en cliquant sur le lien suivant: <br><br>
    <a href="{{ signedUrl|raw }}">Confirmer mon e-mail</a>.
    Ce lien expirera dans {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
</p>

<a href="{{ resendUrl }}">
    Renvoyer l'email de confirmation
</a>

<p>
    Félicitations !
</p>

{% endblock %}