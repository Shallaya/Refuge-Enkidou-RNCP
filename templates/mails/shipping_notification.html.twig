    {# <p>Vous pouvez suivre votre colis avec le numéro de suivi suivant : <strong>{{ order.trackingNumber }}</strong>.</p> #}
    <p>Merci de votre confiance et à bientôt sur notre boutique !</p>

{% endblock %}