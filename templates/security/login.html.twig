{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

    {# affichage des messages flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-message flash-{{ label }}" style="padding: 15px; margin: 10px 0; border-radius: 4px; 
                background-color: {{ label == 'success' ? '#d4edda' : (label == 'error' ? '#f8d7da' : '#d1ecf1') }};
                color: {{ label == 'success' ? '#155724' : (label == 'error' ? '#721c24' : '#0c5460') }};
                border: 1px solid {{ label == 'success' ? '#c3e6cb' : (label == 'error' ? '#f5c6cb' : '#bee5eb') }};">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="page-contact">
        <div class="container">

            <form method="post" class="contact-form">
                
                {% if app.user %}
                    <div class="mb-3">
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Déconnexion</a>
                    </div>
                {% endif %}

                <h1>Veuillez vous connecter</h1>
                <label for="username">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                
                    {# Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html #}

                    <div>
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Se souvenir de moi</label>
                    </div>
            

                <button type="submit">
                    Se connecter
                </button>
            </form>

            <div class="text-center">
                <p class="mb-0">Pas encore de compte ?
                    <a href="{{ path('app_register') }}">Créer un compte</a>
                </p>
            </div>

            {% if error %}
                <div class="alert alert-danger">            
                    <br>            
                    <a href="mailto:support@refuge-enkidou.com">Contacter le support</a>
                </div>        
            {% endif %}

        </div>
    </div>

{% endblock %}
