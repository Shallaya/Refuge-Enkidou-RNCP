{% extends 'base.html.twig' %}

{% block title %}Politique de cookies{% endblock %}

{% block body %}

    <section class="legal">
        <div class="container legal__content">
            <h1 class="section-title">Politique de cookies</h1>

            <br>
            <p>Ce site utilise uniquement des cookies nécessaires à son bon fonctionnement.</p>
            
            <h2>Cookies utilisés</h2>
            
            <ul>
                <li>Session : pour maintenir votre session de connexion</li>
                <li>Panier : pour mémoriser les produits ajoutés à votre panier</li>
                <li>Formulaire : pour la sécurisation des formulaires</li>
            </ul>
            <br>
            <p>Ces cookies ne nécessitent pas de consentement conformément à la réglementation.</p>
            <p>Nous ne collectons aucune donnée à des fins publicitaires ou d’analyse.</p>
        </div>
    </section>

{% endblock %}