{% extends 'base.html.twig' %}

{% block title %}Politique de confidentialité{% endblock %}

{% block body %}
<section class="legal">
    <div class="container legal__content">

        <h1 class="section-title">Politique de confidentialité</h1>

        <br>
        <p>
        Ce site peut collecter certaines données personnelles dans le cadre
        du formulaire de contact ou de la création d’un compte utilisateur.
        </p>

        <h2>Données collectées</h2>

        <ul>
        <li>Nom</li>
        <li>Email</li>
        <li>Adresse de livraison</li>
        </ul>

        <h2>Utilisation</h2>

        <p>
        Ces données sont utilisées uniquement pour le fonctionnement
        du site e-commerce.
        </p>

        <h2>Droit des utilisateurs</h2>

        <p>
        Conformément au RGPD, vous pouvez demander la modification
        ou la suppression de vos données.
        </p>
        
    </div>
</section>
{% endblock %}